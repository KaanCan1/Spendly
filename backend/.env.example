# Docker (docker compose up -d): use this URL
DATABASE_URL="postgresql://spendly:spendly@localhost:5432/spendly"
# No Docker (Homebrew PostgreSQL): copy .env from this file, then run npm run db:create-local
# and set DATABASE_URL to the line the script prints, e.g.:
# DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/spendly"

JWT_SECRET="change-this-to-a-long-random-string"
PORT=3000
# Same Web OAuth client ID as Flutter GOOGLE_WEB_CLIENT_ID
GOOGLE_WEB_CLIENT_ID=""

# Optional: password reset emails (if unset, reset token is only logged on the server in dev)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Spendly <noreply@yourdomain.com>"
