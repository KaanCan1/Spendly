// Copy to Secrets.xcconfig in this folder (gitignored) to override Debug/Release defaults.
//
// Google Cloud Console:
// - Create an OAuth client of type "iOS" with bundle ID com.spendly.spendly → GOOGLE_IOS_CLIENT_ID + reversed scheme below.
// - Keep your "Web application" client for the backend and GIDServerClientID / Flutter GOOGLE_WEB_CLIENT_ID.
//
// Example: client id 123456789-abc.apps.googleusercontent.com →
// GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.123456789-abc
//
// GOOGLE_IOS_CLIENT_ID = 123456789-abc.apps.googleusercontent.com
// GOOGLE_WEB_CLIENT_ID = your-web-client.apps.googleusercontent.com
// GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.123456789-abc
